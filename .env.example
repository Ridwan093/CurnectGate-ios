# Copy this file to .env and adjust for your machine.
# .env is git-ignored but is bundled inside the app as an asset, so anyone
# can read it from the APK. Never put server-side secrets in it
# (Paystack secret keys, database passwords, etc.).
# Any value left empty or removed falls back to the production default.

# development | staging | production
APP_ENV=production

# API root (must include /api/v1).
#   Production       : https://api.curnectgate.com/api/v1
#   Android emulator : http://10.0.2.2:8000/api/v1
#   Physical device  : http://<your PC IPv4>:8000/api/v1   (run ipconfig)
API_BASE_URL=https://api.curnectgate.com/api/v1

# Request timeout in seconds.
API_TIMEOUT_SECONDS=30

# Public links opened in the browser.
WEBSITE_URL=http://www.curnectgate.com
PRIVACY_POLICY_URL=https://curnectgate.com/privacy

# Paystack (public settings only).
PAYSTACK_BACKEND_URL=http://192.168.43.148:3000
PAYSTACK_CALLBACK_URL=https://standard.paystack.co/close
